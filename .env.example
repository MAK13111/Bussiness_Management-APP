# Copy this file to ".env" and fill in your real values.
# ".env" is private (git-ignored). ".env.example" is safe to commit.

# ── Database ─────────────────────────────────────────────────────────
# Option 1: one connection string (takes priority if set)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/purchase_tracker

# Option 2: separate values
PGHOST=localhost
PGPORT=5432
PGDATABASE=purchase_tracker
PGUSER=postgres
PGPASSWORD=Password123

# ── Web server (optional) ────────────────────────────────────────────
# 127.0.0.1 = only this PC. Use 0.0.0.0 to allow other PCs on the network.
APP_HOST=127.0.0.1
APP_PORT=5000

# ── Session secret (optional) ────────────────────────────────────────
# Leave commented to keep using DATABASE/secret.key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=